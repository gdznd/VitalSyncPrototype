DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET=replace-with-a-separate-long-random-secret

# Use the Supabase PostgreSQL connection string for hosted deployments.
# Include sslmode=require in the URL when required by the selected Supabase endpoint.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/vitalsync_db
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PATIENT_PORTAL_URL=http://localhost:5174
